# Read by `npm run build`, which is what the deploy runs. Takes precedence over .env, so local
# `npm run dev` keeps talking to a local backend.
#
# The backend URL is kept here on purpose: it is public, and hard-coding it means a deploy that
# forgets to set it cannot silently fall back to localhost and ship a broken bundle.
VITE_BACKEND_URL=https://ai-doc-backend-1.onrender.com

# VITE_GOOGLE_CLIENT_ID is deliberately NOT set here - it comes from the host's environment
# variables at build time, so it stays out of the repository.
