# Copy to .env and fill in. .env is gitignored; nothing real belongs in this file.

# Base URL of the Spring Boot backend, no trailing slash.
VITE_BACKEND_URL=http://localhost:8080

# Google OAuth client id (Web application type). Must match the backend's
# app.auth.google.client-id, which pins the ID token's audience to it.
#
# Vite inlines this at BUILD time, so the deployed value is set as an environment variable on
# the host and the bundle is rebuilt - changing it afterwards does nothing.
VITE_GOOGLE_CLIENT_ID=
